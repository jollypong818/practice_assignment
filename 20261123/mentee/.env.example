# mentee 또는 mentor 루트에 .env로 복사한 뒤 자신의 값으로 수정합니다.
OPENAI_API_KEY=CHANGE_ME_OPENAI_API_KEY
# 기존 수업에서 사용하는 Responses/Structured Output 지원 모델 ID
LLM_MODEL=CHANGE_ME_MODEL_ID

# Windows에 이미 설치한 PostgreSQL의 계정
PGHOST=localhost
PGPORT=5432
PGDATABASE=knowledge_lab
PGUSER=postgres
PGPASSWORD=CHANGE_ME_DATABASE_PASSWORD

# 이 자료만 사용하는 전용 Schema. 다른 날짜 Schema 이름을 넣지 않습니다.
RAG_SCHEMA=d26_rag
E5_REVISION=main
