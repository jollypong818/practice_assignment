# Windows 11, Git Bash. .env에는 실제 비밀번호·API 키를 입력하고 Git에 올리지 않습니다.
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/report_agent_lab
EMBEDDING_MODEL=intfloat/multilingual-e5-small
SEARCH_MIN_SIMILARITY=0.75
OPENAI_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=400
PROJECT_LEVEL=basic
